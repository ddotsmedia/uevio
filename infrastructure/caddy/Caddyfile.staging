{
  email devops@uevio.com
  admin off
}

staging.uevio.com {
  reverse_proxy uevio-web:3002
}

business.staging.uevio.com {
  reverse_proxy uevio-business:3003
}

admin.staging.uevio.com {
  reverse_proxy uevio-admin:3004
  basicauth {
    admin $2a$14$CHANGE_BCRYPT_HASH
  }
}

api.staging.uevio.com {
  reverse_proxy uevio-api:3001
}
