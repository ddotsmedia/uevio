{
  email devops@uevio.com
  admin off
}

uevio.com, www.uevio.com {
  redir https://uevio.com{uri} 301
  reverse_proxy uevio-web:3002
}

business.uevio.com {
  reverse_proxy uevio-business:3003
}

admin.uevio.com {
  reverse_proxy uevio-admin:3004
}

api.uevio.com {
  reverse_proxy uevio-api:3001
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
  }
}
