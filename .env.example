# =============================================================================
# UEVIO Platform — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to git
# =============================================================================

# --- Database ---
DATABASE_URL="postgresql://uevio:CHANGE_ME@localhost:5432/uevio_dev"
DATABASE_URL_DIRECT="postgresql://uevio:CHANGE_ME@localhost:5432/uevio_dev"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- NextAuth ---
NEXTAUTH_SECRET="CHANGE_ME_32_CHAR_RANDOM_STRING"
NEXTAUTH_URL="http://localhost:3002"

# --- Cloudflare R2 ---
R2_ACCOUNT_ID="CHANGE_ME"
R2_ACCESS_KEY_ID="CHANGE_ME"
R2_SECRET_ACCESS_KEY="CHANGE_ME"
R2_BUCKET_NAME="uevio-media"
R2_PUBLIC_URL="https://media.uevio.com"

# --- Email (SMTP) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@uevio.com"
SMTP_PASS="CHANGE_ME"
SMTP_FROM="UEVIO <noreply@uevio.com>"

# --- App URLs ---
NEXT_PUBLIC_WEB_URL="http://localhost:3002"
NEXT_PUBLIC_BUSINESS_URL="http://localhost:3003"
ADMIN_URL="http://localhost:3004"
API_URL="http://localhost:3001"

# --- API Internal ---
API_PORT="3001"
API_SECRET_KEY="CHANGE_ME_64_CHAR_RANDOM_STRING"

# --- PostgreSQL (for Docker Compose) ---
POSTGRES_USER="uevio"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="uevio_prod"
REDIS_PASSWORD="CHANGE_ME"

# --- Feature flags ---
ENABLE_ARABIC="true"
ENABLE_REVIEWS="true"
ENABLE_MARKETPLACE="true"
