{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@uevio/database": ["./packages/database/src/index.ts"],
      "@uevio/shared": ["./packages/shared/src/index.ts"],
      "@uevio/config": ["./packages/config/src/index.ts"],
      "@uevio/i18n": ["./packages/i18n/src/index.ts"],
      "@uevio/permissions": ["./packages/permissions/src/index.ts"],
      "@uevio/validation": ["./packages/validation/src/index.ts"]
    }
  }
}
